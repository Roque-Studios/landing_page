# Copy to .env and fill in before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# Postgres (leads database)
POSTGRES_USER=roque
POSTGRES_PASSWORD=change_me
POSTGRES_DB=roque_leads
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# leads-api
ENVIRONMENT=production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://roquestudios.io

# Resend (https://resend.com) — leave RESEND_API_KEY empty to disable email
# notifications; leads are still stored in Postgres either way.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFY_EMAIL=contacto@roquestudios.io

SENTRY_DSN=
